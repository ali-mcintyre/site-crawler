            const notificationPermissionOverlayCSS = '#dy-notification-permission-overlay{position:fixed;top:0;left:50%;min-width:200px;border-radius:8px;transform:translatex(-50%);background:#fff;box-shadow:0 0 10px rgba(0,0,0,.5);z-index:1000}#dy-notification-permission-overlay .dy-overlay__popup{padding:16px;display:flex;flex-direction:column;gap:16px}#dy-notification-permission-overlay .dy-overlay__bottom{display:grid;grid-template-columns:1fr 1fr;gap:8px}#dy-notification-permission-overlay .dy-overlay__bottom button{display:flex;min-width:112px;padding:8px 16px;justify-content:center;align-items:center;border-radius:8px;font-family:FormaDJRUI,-apple-system,BlinkMacSystemFont,sans-serif;font-size:16px;font-style:normal;font-weight:400;line-height:20px;cursor:pointer}#dy-notification-permission-overlay .dy-overlay__bottom .dy-overlay__btn--primary{background-color:#024ad8;border-color:#024ad8;color:#fff}#dy-notification-permission-overlay .dy-overlay__bottom .dy-overlay__btn--secondary{color:#024ad8;background:#fff;border-color:transparent}#dy-notification-permission-overlay h2.dy-overlay__title{color:#1a1a1a;font-family:FormaDJRUI,-apple-system,BlinkMacSystemFont,sans-serif;font-size:20px;font-style:normal;font-weight:400;line-height:24px}#dy-notification-permission-overlay p.dy-overlay__description{color:#1a1a1a;font-family:FormaDJRUI,-apple-system,BlinkMacSystemFont,sans-serif;font-size:14px;font-style:normal;font-weight:400;line-height:20px}#dy-notification-permission-overlay .dy-overlay__content{display:flex;flex-direction:column;align-items:flex-start;gap:2px;max-width:320px}#dy-notification-permission-overlay .dy-overlay__icon{display:flex}#dy-notification-permission-overlay .dy-overlay__top{display:flex;gap:8px}@media screen and (max-width: 767px){#dy-notification-permission-overlay .dy-overlay__bottom{grid-template-columns:1fr}}';

            const getCookie = (name) => {
                const value = '; ' + document.cookie;
                const parts = value.split('; ' + name + '=');
                if (parts.length === 2) {
                    return parts.pop().split(';').shift();
