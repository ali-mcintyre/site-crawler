                const overlay = document.getElementById('dy-notification-permission-overlay');
                if (overlay) {
                    const btnEnable = overlay.querySelector('.dy-overlay__btn--primary');
                    if (btnEnable) {
                        btnEnable.addEventListener('click', () => {
                            requestNotificationPermission();
                            overlay.remove();
                        });
                    }
                    const btnDismiss = overlay.querySelector('.dy-overlay__btn--secondary');
                    if (btnDismiss) {
                        btnDismiss.addEventListener('click', () => {
                            localStorage.setItem(localStorageLabels.notificationOptIn, 'false');
                            overlay.remove();
                        });
                    }
                }
