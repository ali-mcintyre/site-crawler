<style id="metro-pattern-styles">
      /* CSS Custom Properties for Metro Pattern */
      
      /* Metro Pattern Container */
      [data-pattern] {
        display: grid;
        grid-template-columns: repeat(var(--glyphs-per-row, 4), 1fr);
        gap: 0;
        width: 100%;
        min-height: 200px;
        position: relative;
        overflow: visible;
        padding: 3px;
        box-sizing: border-box;
      }
      
      /* Glyph Container */
      .glyph {
        position: relative;
        width: 100%;
        aspect-ratio: calc(var(--glyph-width, 4) / var(--glyph-height, 6));
        overflow: visible;
      }
      
      /* Shape Elements */
      .shape {
        position: absolute;
        z-index: 1;
        transition: all 0.3s ease;
      }
      
      /* Mobile Responsive */
      @media (max-width: 767px) {
        [data-pattern] {
          gap: 2px;
        }
        .glyph {
          aspect-ratio: calc(var(--glyph-width, 4) / var(--glyph-height, 6));
        }
      }
    </style><script src="https://metro.org/wp-includes/js/wp-emoji-release.min.js?ver=7.0" defer=""></script></head>

